# Strava app — https://www.strava.com/settings/api
# Set "Authorization Callback Domain" to localhost for local dev.
STRAVA_CLIENT_ID=your-client-id
STRAVA_CLIENT_SECRET=your-client-secret

# Image edits for opt-in runner avatars
OPENAI_API_KEY=
# Optional; defaults to gpt-5.4-mini for coach comments
OPENAI_TEXT_MODEL=

# Apple Maps (training map). Either paste a ready-made MapKit JS token from
# developer.apple.com → Certificates, Identifiers & Profiles → Services → Maps → Tokens:
APPLE_MAPS_TOKEN=
# …or let the backend sign short-lived tokens from a Maps .p8 key (preferred):
APPLE_MAPS_TEAM_ID=
APPLE_MAPS_KEY_ID=
# Contents of AuthKey_XXXXXXXXXX.p8 on one line, newlines written as \n
APPLE_MAPS_PRIVATE_KEY=

# Any random string; used once when creating the webhook subscription
STRAVA_WEBHOOK_VERIFY_TOKEN=your-verify-token
# Returned by Strava after creating the subscription; leave empty until then
STRAVA_WEBHOOK_SUBSCRIPTION_ID=

# Generate with: python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_ENCRYPTION_KEY=

# Generate with: openssl rand -hex 32
SESSION_SECRET=

# Public origin. http://localhost for docker compose, http://localhost:5173 for vite dev
APP_BASE_URL=http://localhost
